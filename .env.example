# ─────────────────────────────────────────────────────────────
# ARCHI-DESIGN — variables d'environnement
# Copier ce fichier en .env puis compléter. Ne jamais versionner .env.
# ─────────────────────────────────────────────────────────────

# Base PostgreSQL : postgres://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/BASE
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/archi_design

# Clé secrète de Payload (sessions, jetons). Chaîne aléatoire d'au moins 32 caractères.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=CHANGE_ME

# Adresse publique du site, sans barre finale (liens, SEO, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro WhatsApp par défaut (chiffres uniquement, indicatif compris).
# Le numéro saisi dans « Réglages du site » du back-office est prioritaire.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Premier compte administrateur créé par « npm run seed »
SEED_ADMIN_EMAIL=admin@archidesignguinee.com
SEED_ADMIN_PASSWORD=CHANGE_ME

# Compte client de démonstration (espace client), créé par « npm run seed » si renseigné
SEED_CLIENT_EMAIL=client.demo@archidesignguinee.com
SEED_CLIENT_PASSWORD=

# ─── E-mails (serveur SMTP de la messagerie LWS) ───
# Paramètres dans l'espace client LWS > Messagerie > Configuration.
# Sans SMTP_HOST, les e-mails sont enregistrés en HTML dans .emails/ (développement).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=ARCHI-DESIGN Guinée

# ─── Hébergement ───
# Vercel Blob (posé automatiquement par Vercel) : sans ce jeton, les fichiers restent sur le disque
BLOB_READ_WRITE_TOKEN=
# Taille maximale des fichiers joints aux formulaires, en Mo. Sur Vercel : 4 et 4 (limite de 4,5 Mo par requête)
NEXT_PUBLIC_UPLOAD_FILE_MB=10
NEXT_PUBLIC_UPLOAD_TOTAL_MB=50
